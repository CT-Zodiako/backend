generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  EVALUATOR
}

enum EvaluationPeriodNumber {
  FIRST
  SECOND
}

model User {
  id               String             @id @default(uuid()) @db.Uuid
  username         String             @unique
  passwordHash     String
  role             UserRole
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  projects         ProjectMember[]
  assignedProjects ProjectEvaluator[]
  evaluations      Evaluation[]

  @@map("users")
}

model EvaluationPeriod {
  id               String                 @id @default(uuid()) @db.Uuid
  year             Int
  number           EvaluationPeriodNumber
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime               @default(now())
  categoryEditions CategoryEdition[]

  @@unique([year, number])
  @@map("evaluation_periods")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  editions    CategoryEdition[]

  @@map("categories")
}

model CategoryEdition {
  id         String                @id @default(uuid()) @db.Uuid
  categoryId String                @db.Uuid
  periodId   String                @db.Uuid
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  period     EvaluationPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  criteria   EvaluationCriterion[]
  projects   Project[]
  winner     CategoryWinner?
  createdAt  DateTime              @default(now())

  @@unique([categoryId, periodId])
  @@index([periodId])
  @@map("category_editions")
}

model EvaluationCriterion {
  id          String            @id @default(uuid()) @db.Uuid
  editionId   String            @db.Uuid
  name        String
  description String?
  isActive    Boolean           @default(true)
  edition     CategoryEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  scores      EvaluationScore[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([editionId, name])
  @@index([editionId])
  @@map("evaluation_criteria")
}

model Project {
  id                 String             @id @default(uuid()) @db.Uuid
  categoryEditionId  String             @db.Uuid
  name               String
  description        String
  categoryEdition    CategoryEdition    @relation(fields: [categoryEditionId], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  assignedEvaluators ProjectEvaluator[]
  evaluations        Evaluation[]
  result             ProjectResult?
  winner             CategoryWinner?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([categoryEditionId])
  @@map("projects")
}

model ProjectMember {
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  joinedAt  DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectEvaluator {
  projectId   String   @db.Uuid
  evaluatorId String   @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluator   User     @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  assignedAt  DateTime @default(now())

  @@id([projectId, evaluatorId])
  @@index([evaluatorId])
  @@map("project_evaluators")
}

model Evaluation {
  id          String            @id @default(uuid()) @db.Uuid
  projectId   String            @db.Uuid
  evaluatorId String            @db.Uuid
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluator   User              @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)
  scores      EvaluationScore[]
  comment     String?
  submittedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, evaluatorId])
  @@index([evaluatorId])
  @@map("evaluations")
}

model EvaluationScore {
  id           String              @id @default(uuid()) @db.Uuid
  evaluationId String              @db.Uuid
  criterionId  String              @db.Uuid
  score        Int
  evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@map("evaluation_scores")
}

model ProjectResult {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @unique @db.Uuid
  averageScore     Decimal  @db.Decimal(5, 2)
  evaluationsCount Int
  calculatedAt     DateTime @default(now())
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_results")
}

model CategoryWinner {
  id                String          @id @default(uuid()) @db.Uuid
  categoryEditionId String          @unique @db.Uuid
  projectId         String          @unique @db.Uuid
  decidedAt         DateTime        @default(now())
  categoryEdition   CategoryEdition @relation(fields: [categoryEditionId], references: [id], onDelete: Restrict)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@map("category_winners")
}
